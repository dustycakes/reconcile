<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Reconcile</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Runs" asp-action="Index">RECONCILE</a>
        <nav>
            <a asp-controller="Runs" asp-action="Index">Runs</a>
            <a asp-controller="Runs" asp-action="New">New reconciliation</a>
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="foot">
        Demonstration application. Every donor, gift, and transaction in it is generated data.
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
