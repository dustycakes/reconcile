@using Reconcile.Core.Matching
@using Reconcile.Core.Reporting
@using Reconcile.Core.SampleData
@using Reconcile.Web.Services
@model ReconciliationRun
@{
    ViewData["Title"] = $"Run #{Model.Id}";
    var results = Model.MatchResults;
    int C(MatchStatus s) => results.Count(r => r.Status == s);
    decimal Money(MatchStatus s) => results.Where(r => r.Status == s)
        .Sum(r => r.DonationRecord?.Amount ?? r.SettlementLine?.Gross ?? 0m);
    var netDelta = results.Sum(r => r.AmountDelta ?? 0m);
    var findings = results.Where(r => r.Status != MatchStatus.Matched)
        .OrderBy(r => r.Status).ThenBy(r => r.SettlementLine?.SettledOn ?? r.DonationRecord?.ReceivedOn)
        .ToList();
    var bridge = ReconciliationBridge.From(Model.SettlementLines, Model.DonationRecords, results);
    var edits = ReconciliationService.ReadScenario(Model);
    var isSample = Model.SettlementFileName.StartsWith("sample-");
    var refusedId = findings.FirstOrDefault(r => r.Note?.StartsWith(FindingNotes.NotPairedOnPurpose) == true)?.Id;

    List<MatchResult> Touching(TamperEdit e) => results
        .Where(r => r.SettlementLine?.ProcessorRef == e.ProcessorRef || r.DonationRecord?.RecordRef == e.RecordRef)
        .ToList();
}

<h1>Run #@Model.Id</h1>
<p class="sub mono-sub">
    <span class="dim">@Model.SettlementFileName · @Model.DonationFileName · created @Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span><br />
    @Model.SettlementLines.Count settlement lines and @Model.DonationRecords.Count donation records,
    every one accounted for below. <a asp-action="Report" asp-route-id="@Model.Id">Printable report →</a>
</p>

@if (Model.ImportNotes is not null)
{
    <div class="notes"><strong>Import problems (rows kept out, shown here):</strong>
@Model.ImportNotes</div>
}

@if (edits.Count > 0)
{
    var caught = edits.Count(e => Touching(e).Any(r => r.Status != MatchStatus.Matched));
    <section class="edits">
        <h2>Your edits, and where they landed</h2>
        <p class="sub">
            @caught of @edits.Count edits surfaced as findings, and the
            <a asp-action="Report" asp-route-id="@Model.Id" asp-fragment="bridge">bridge</a>
            @(bridge.Unexplained == 0 ? "still ties to the cent" : $"is off by ${bridge.Unexplained:N2}").
            <a href="/break">Try different edits →</a>
        </p>
        <div class="tablewrap">
            <table>
                <thead><tr><th>Your edit</th><th>Should land as</th><th>Landed as</th></tr></thead>
                <tbody>
                    @foreach (var e in edits)
                    {
                        var hits = Touching(e).Where(r => r.Status != MatchStatus.Matched).ToList();
                        <tr class="has-note">
                            <td>@e.Describe()</td>
                            <td class="dim">@Tampering.Predicted(e.Kind)</td>
                            <td>
                                @if (hits.Count == 0)
                                {
                                    <span class="status MissingInCrm">Not caught</span>
                                }
                                @foreach (var h in hits)
                                {
                                    <span class="status @h.Status">@h.Status.Label()</span>
                                }
                            </td>
                        </tr>
                        @* One note per edit: the record the edit touched speaks for it. *@
                        var lead = hits.OrderBy(h => h.DonationRecord?.RecordRef == e.RecordRef ? 0 : 1).FirstOrDefault();
                        <tr class="note-row"><td colspan="3">@(lead?.Note ?? "The engine treated this record as a clean match.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else if (isSample)
{
    <ol class="guide">
        <li>
            <a href="#refused"><b>The gift it refused to guess</b></a>
            <span>One $200 gift, two $200 settlements a day apart. All three are flagged, and each names the others.</span>
        </li>
        <li>
            <a asp-action="Report" asp-route-id="@Model.Id" asp-fragment="bridge"><b>The bridge</b></a>
            <span>Settled gross walked to the CRM total through the findings. Unexplained: $@bridge.Unexplained.ToString("N2").</span>
        </li>
        <li>
            <a href="/break"><b>Try to break it</b></a>
            <span>Change, delete or duplicate records yourself and see what the engine makes of them.</span>
        </li>
    </ol>
}

<div class="tiles" id="tiles">
    <button class="tile ok" data-status="Matched" aria-pressed="false">
        <span class="n">@C(MatchStatus.Matched)</span>
        <span class="k">Matched</span>
        <span class="m">$@Money(MatchStatus.Matched).ToString("N2")</span>
    </button>
    <button class="tile ok" data-status="ProbableMatch" aria-pressed="false">
        <span class="n">@C(MatchStatus.ProbableMatch)</span>
        <span class="k">Probable, needs review</span>
        <span class="m">$@Money(MatchStatus.ProbableMatch).ToString("N2")</span>
    </button>
    <button class="tile warn" data-status="AmountMismatch" aria-pressed="false">
        <span class="n">@C(MatchStatus.AmountMismatch)</span>
        <span class="k">Amount mismatch</span>
        <span class="m">net Δ @(netDelta < 0 ? "−" : "+")$@Math.Abs(netDelta).ToString("N2")</span>
    </button>
    <button class="tile bad" data-status="MissingInCrm" aria-pressed="false">
        <span class="n">@C(MatchStatus.MissingInCrm)</span>
        <span class="k">Missing in CRM</span>
        <span class="m">$@Money(MatchStatus.MissingInCrm).ToString("N2")</span>
    </button>
    <button class="tile bad" data-status="MissingInProcessor" aria-pressed="false">
        <span class="n">@C(MatchStatus.MissingInProcessor)</span>
        <span class="k">Missing at processor</span>
        <span class="m">$@Money(MatchStatus.MissingInProcessor).ToString("N2")</span>
    </button>
</div>

<h2>Findings: each row names the records and what to check</h2>
<label class="dim no-print" style="font-size:0.85rem">
    <input type="checkbox" id="show-matched" /> also show the @C(MatchStatus.Matched) matched rows
</label>

<div class="tablewrap" style="margin-top:0.6rem">
    <table id="results">
        <thead>
            <tr>
                <th>Status</th>
                <th>Processor ref</th><th class="money">Gross</th><th>Settled</th>
                <th>CRM record</th><th>Donor</th><th>Fund</th><th class="money">Amount</th><th>Received</th>
                <th class="money">Δ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in findings.Concat(results.Where(x => x.Status == MatchStatus.Matched)))
            {
                var s = r.SettlementLine; var d = r.DonationRecord;
                <tr data-status="@r.Status" hidden="@(r.Status == MatchStatus.Matched)" class="@(r.Note is null ? "" : "has-note") @(r.Id == refusedId ? "refused" : "")" id="@(r.Id == refusedId ? "refused" : null)">
                    <td><span class="status @r.Status">@r.Status.Label()</span></td>
                    <td class="mono">@(s?.ProcessorRef ?? d?.ProcessorRef ?? "—")</td>
                    <td class="money">@(s is null ? "—" : $"${s.Gross:N2}")</td>
                    <td class="mono">@(s?.SettledOn.ToString("MM-dd") ?? "—")</td>
                    <td class="mono">@(d?.RecordRef ?? "—")</td>
                    <td>@(d?.DonorName ?? "—")</td>
                    <td class="dim">@(d?.Fund ?? "—")</td>
                    <td class="money">@(d is null ? "—" : $"${d.Amount:N2}")</td>
                    <td class="mono">@(d?.ReceivedOn.ToString("MM-dd") ?? "—")</td>
                    <td class="money @(r.AmountDelta > 0 ? "delta-pos" : r.AmountDelta < 0 ? "delta-neg" : "")">
                        @(r.AmountDelta.HasValue ? $"{(r.AmountDelta > 0 ? "+" : "−")}${Math.Abs(r.AmountDelta.Value):N2}" : "")
                    </td>
                </tr>
                @if (r.Note is not null)
                {
                    <tr data-status="@r.Status" class="note-row">
                        <td class="mono dim">@r.MatchedBy</td><td colspan="9">@r.Note</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    // Tile click = filter the table to that status; click again to clear.
    // The matched checkbox reveals the clean rows for spot-checking.
    (function () {
        const tiles = document.querySelectorAll('#tiles .tile');
        const rows = document.querySelectorAll('#results tbody tr');
        const showMatched = document.getElementById('show-matched');
        let active = null;

        function apply() {
            rows.forEach(tr => {
                const st = tr.dataset.status;
                const matchedHidden = st === 'Matched' && !showMatched.checked && active !== 'Matched';
                tr.hidden = matchedHidden || (active !== null && st !== active);
            });
            tiles.forEach(t => t.setAttribute('aria-pressed', String(t.dataset.status === active)));
        }

        tiles.forEach(t => t.addEventListener('click', () => {
            active = active === t.dataset.status ? null : t.dataset.status;
            apply();
        }));
        showMatched.addEventListener('change', apply);
    })();
</script>
}
